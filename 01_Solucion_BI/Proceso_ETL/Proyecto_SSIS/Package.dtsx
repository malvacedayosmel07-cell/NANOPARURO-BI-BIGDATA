    <DTS:Executable
      DTS:refId="Package\02 - Carga de dimensiones"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Tarea Ejecutar SQL"
      DTS:DTSID="{9B4CD582-EFA3-418A-B79D-99923B5890AF}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="02 - Carga de dimensiones"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{EB72970B-568B-4A10-BE32-E8C5EDEBEAC8}"
          SQLTask:SqlStatementSource="USE BI_Nanoparuro_V2;&#xA;&#xA;SET XACT_ABORT ON;&#xA;&#xA;BEGIN TRANSACTION;&#xA;&#xA;-- ==========================================&#xA;-- 1. CARGA DIM_CLIENTE&#xA;-- ==========================================&#xA;&#xA;INSERT INTO dbo.DIM_CLIENTE&#xA;(&#xA;    CustomerID,&#xA;    NombreCliente,&#xA;    TipoCliente&#xA;)&#xA;SELECT&#xA;    s.CustomerID,&#xA;    MAX(s.NombreCliente),&#xA;    MAX(s.TipoCliente)&#xA;FROM dbo.STG_Ventas s&#xA;WHERE NOT EXISTS (&#xA;    SELECT 1&#xA;    FROM dbo.DIM_CLIENTE d&#xA;    WHERE d.CustomerID = s.CustomerID&#xA;)&#xA;GROUP BY s.CustomerID;&#xA;&#xA;&#xA;-- ==========================================&#xA;-- 2. CARGA DIM_PRODUCTO&#xA;-- ==========================================&#xA;&#xA;INSERT INTO dbo.DIM_PRODUCTO&#xA;(&#xA;    ProductID,&#xA;    NombreProducto,&#xA;    Categoria,&#xA;    Subcategoria&#xA;)&#xA;SELECT&#xA;    s.ProductID,&#xA;    MAX(s.NombreProducto),&#xA;    MAX(s.Categoria),&#xA;    MAX(s.Subcategoria)&#xA;FROM dbo.STG_Ventas s&#xA;WHERE NOT EXISTS (&#xA;    SELECT 1&#xA;    FROM dbo.DIM_PRODUCTO d&#xA;    WHERE d.ProductID = s.ProductID&#xA;)&#xA;GROUP BY s.ProductID;&#xA;&#xA;&#xA;-- ==========================================&#xA;-- 3. CARGA DIM_GEOGRAFIA&#xA;-- ==========================================&#xA;&#xA;INSERT INTO dbo.DIM_GEOGRAFIA&#xA;(&#xA;    Ciudad,&#xA;    Estado,&#xA;    Region,&#xA;    CodigoPostal&#xA;)&#xA;SELECT DISTINCT&#xA;    s.Ciudad,&#xA;    s.Estado,&#xA;    s.Region,&#xA;    s.CodigoPostal&#xA;FROM dbo.STG_Ventas s&#xA;WHERE NOT EXISTS (&#xA;    SELECT 1&#xA;    FROM dbo.DIM_GEOGRAFIA d&#xA;    WHERE d.Ciudad IS NOT DISTINCT FROM s.Ciudad&#xA;      AND d.Estado IS NOT DISTINCT FROM s.Estado&#xA;      AND d.Region IS NOT DISTINCT FROM s.Region&#xA;      AND d.CodigoPostal IS NOT DISTINCT FROM s.CodigoPostal&#xA;);&#xA;&#xA;&#xA;-- ==========================================&#xA;-- 4. CARGA DIM_FECHA&#xA;-- ==========================================&#xA;&#xA;SET LANGUAGE Spanish;&#xA;&#xA;INSERT INTO dbo.DIM_FECHA&#xA;(&#xA;    FechaKey,&#xA;    Fecha,&#xA;    Dia,&#xA;    Mes,&#xA;    NombreMes,&#xA;    Trimestre,&#xA;    [Año]&#xA;)&#xA;SELECT DISTINCT&#xA;    CONVERT(INT, CONVERT(CHAR(8), s.FechaVenta, 112)),&#xA;    s.FechaVenta,&#xA;    DAY(s.FechaVenta),&#xA;    MONTH(s.FechaVenta),&#xA;    DATENAME(MONTH, s.FechaVenta),&#xA;    DATEPART(QUARTER, s.FechaVenta),&#xA;    YEAR(s.FechaVenta)&#xA;FROM dbo.STG_Ventas s&#xA;WHERE NOT EXISTS (&#xA;    SELECT 1&#xA;    FROM dbo.DIM_FECHA d&#xA;    WHERE d.FechaKey =&#xA;        CONVERT(INT, CONVERT(CHAR(8), s.FechaVenta, 112))&#xA;);&#xA;&#xA;&#xA;-- ==========================================&#xA;-- 5. CARGA DIM_VENDEDOR&#xA;-- ==========================================&#xA;&#xA;INSERT INTO dbo.DIM_VENDEDOR&#xA;(&#xA;    SellerID,&#xA;    NombreVendedor&#xA;)&#xA;SELECT&#xA;    s.SellerID,&#xA;    MAX(s.NombreVendedor)&#xA;FROM dbo.STG_Ventas s&#xA;WHERE NOT EXISTS (&#xA;    SELECT 1&#xA;    FROM dbo.DIM_VENDEDOR d&#xA;    WHERE d.SellerID = s.SellerID&#xA;)&#xA;GROUP BY s.SellerID;&#xA;&#xA;COMMIT TRANSACTION;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\03 - Carga FACT_VENTAS"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Tarea Ejecutar SQL"
      DTS:DTSID="{CCCD9A13-162C-4F5E-BE20-480CD2EA7508}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="03 - Carga FACT_VENTAS"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{EB72970B-568B-4A10-BE32-E8C5EDEBEAC8}"
          SQLTask:SqlStatementSource="USE BI_Nanoparuro_V2;&#xA;&#xA;SET XACT_ABORT ON;&#xA;&#xA;BEGIN TRANSACTION;&#xA;&#xA;DELETE FROM dbo.FACT_VENTAS;&#xA;&#xA;INSERT INTO dbo.FACT_VENTAS&#xA;(&#xA;    ClienteKey,&#xA;    ProductoKey,&#xA;    FechaKey,&#xA;    GeografiaKey,&#xA;    VendedorKey,&#xA;    OrderID,&#xA;    Cantidad,&#xA;    Precio,&#xA;    CostoFlete&#xA;)&#xA;SELECT&#xA;    C.ClienteKey,&#xA;    P.ProductoKey,&#xA;    F.FechaKey,&#xA;    G.GeografiaKey,&#xA;    V.VendedorKey,&#xA;    S.OrderID,&#xA;    S.Cantidad,&#xA;    S.Precio,&#xA;    S.CostoFlete&#xA;FROM dbo.STG_Ventas S&#xA;INNER JOIN dbo.DIM_CLIENTE C&#xA;    ON S.CustomerID = C.CustomerID&#xA;INNER JOIN dbo.DIM_PRODUCTO P&#xA;    ON S.ProductID = P.ProductID&#xA;INNER JOIN dbo.DIM_FECHA F&#xA;    ON S.FechaVenta = F.Fecha&#xA;INNER JOIN dbo.DIM_GEOGRAFIA G&#xA;    ON S.Ciudad = G.Ciudad&#xA;    AND S.Estado = G.Estado&#xA;    AND S.Region = G.Region&#xA;    AND S.CodigoPostal = G.CodigoPostal&#xA;INNER JOIN dbo.DIM_VENDEDOR V&#xA;    ON S.SellerID = V.SellerID;&#xA;&#xA;IF (SELECT COUNT(*) FROM dbo.FACT_VENTAS)&#xA;    &lt;&gt; (SELECT COUNT(*) FROM dbo.STG_Ventas)&#xA;BEGIN&#xA;    ROLLBACK TRANSACTION;&#xA;    THROW 50001, 'Error en la cantidad de ventas cargadas.', 1;&#xA;END;&#xA;&#xA;COMMIT TRANSACTION;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
